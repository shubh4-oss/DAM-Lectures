#Byjus case
import pandas as pd
import numpy as np

df = pd.read_excel("/content/Lecture2_data.xlsx")

print(df.head)
print(df.shape)
df.info()
df["Customer_Rating"] = df["Customer_Rating"].fillna(df["Customer_Rating"].mean())

print(df.dtypes)

df["Total_Cost_Lakh"] = (
    df["Marketing_Spend_Lakh"]
   + df["Content_Cost_Lakh"]
   + df["Salary_Cost_Lakh"]
  +  df["Other_Cost_Lakh"]
)
df["Profit_Lakh"] = df["Revenue_Lakh"] - df["Total_Cost_Lakh"]

print(df[["Product", "Revenue_Lakh", "Total_Cost_Lakh", "Profit_Lakh"]].head(10))

#missing value
print(df.isna().sum())

#if statement
rating=df["Customer_Rating"].mean()

if rating>=4:
  print("customer satisfaction is good")

R = df["Revenue_Lakh"].mean()
print("Average Revenue:",R)

if R >= 300:
  print("Average revenue is high")

"""Lecture 3 continuation of Byju's Case

"""

#Byjus case
import pandas as pd
import numpy as np

df = pd.read_csv("/content/Lecture2_data - Lecture2_data.csv.csv")

revenue = df["Revenue_Lakh"].mean()
rating = df["Customer_Rating"].mean()

if revenue >= 300:
  print("Average revenue is high")

  if rating >= 4:
    print("customer stastifaction is also good")
  else:
    print("customer staisfaction needs improvement")
else:
  print("revenue is low")

rating = df["Customer_Rating"].mean()

if rating >= 4.5:
  print("excellent")

elif rating >= 4.0:
    print("Good")

elif rating >= 3.0:
   print("average")

else:
  print("needs improvement")

#for loop
for rating in df["Customer_Rating"]:

  if rating >= 4:
    print("Good Rating")
  else:
     print("needs improvement")

#for loop with range

for i in range(10):
  print(df["Product"].iloc[i], df["Revenue_Lakh"].iloc[i])

#while loop
i=0
while i<5:
  revenue = df["Revenue_Lakh"].iloc[i]

  if revenue>=300:
    print("High Revenue:", revenue)
  else:
      print("Low Revenue:", revenue)

  i=i+1

"""Lecture 4 Case of Starbucks

"""

import pandas as pd

FILE = "/content/Starbucks_India_Sales_Dataset.xlsx"

df = pd.read_excel(FILE, sheet_name="Sales_Data")
products_df = pd.read_excel(FILE, sheet_name="Products")
stores_df = pd.read_excel(FILE, sheet_name="Stores")

print("sales table:", df.shape)
print("products:", products_df.shape)
print("Stors:", stores_df.shape)

df.head()

menu = ["Cappuccino", "Latte", "Americano", "Cold Brew", "Frappuccino", "Masala Chai", "Blueberry Muffin", "Veg Sandwich"]

store =("S01", "Connaught Place", "Delhi")

cities = {"Delhi", "Mumbai", "Bengaluru", "Hyderabad", "Pune", "Delhi"}

price = {"Cappuccino": 250, "Latte": 270, "Americano": 220, "Cold Brew": 300, "Frappuccino": 350, "Masala Chai": 200, "Blueberry Muffin": 180, "Veg Sandwich": 240}

print("List  :", menu)
print("Tuple :", store)
print("Set   :", cities, "<-'Delhi' typed twice, stored once")
print("Dicitonary  :", price)
print()
print(type(menu), type(store), type(cities), type(price))

""" Section 2 : Assessing the elements of data structure

"""

print("First item  :", menu[0])
print("Last item :", menu[-1])
print("First item   :", menu[0:3])
print("Every 2nd item :", menu[::2])

print("\nStore ID  :", store[0])
print("Store city  :", store[2])

print("\nPrice of Latte :", price["Latte"])
print("Safe Lookup  :", price.get("Pizza", "Not on menu"))

print("\nIs Pune a Starbucks city?", "Pune" in cities)
print("Is Jaipur a Starbucks city?", "Jaipur" in cities)

"""#Apply function to data structure


"""

revenue_list = df["Revenue"].tolist()
print("Number of orders :", len(revenue_list))
print("Total revenue : Rs", round(sum(revenue_list), 2))
print("Average order value : Rs", round(sum(revenue_list)/len(revenue_list),2))
print("Biggest Order : Rs", max(revenue_list))
print("Smallest order : Rs", min(revenue_list))
print("Top 5 orders:", sorted(revenue_list, reverse=True)[:5])

"""Lecture 5 -Classification / Descriptive statistics/Data  visualization
bold text

"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px

df = pd.read_excel("/content/Zomato_India_Orders_Dataset.xlsx", sheet_name="Orders_Data")
print("Data loaded:", df.shape[0],"orders and", df.shape[1], "variables")

#attributes
# 1 shape : tell us the number of rows and columns
print("shape", df.shape)
# 2 columns : shows the names of all columns
print("\ncolumns:")
print (df.columns)
# 3 Index : shows the row labels
print("\nIndex:")
print(df.index)
# 4 Data Types : tell us the type of data in each columns
print("\nData Types:")
print(df.dtypes)
# structure summary
df.info()

"""Classification of Data  """



number_cols = ["Items_Count", "Order_Value", "Discount_Pct", "Delivery_Fee", "Distance_Km", "Delivery_Time_Min", "Rating", "Final_Amount"]
 category_cols = ["City", "Cuisine", "Customer Segment", "Platform", "Payment_Mode"]
 date_cols = ["Order_Date"]
 id_cols = ["Order_ID"]

 print("Numerical :", len(number_cols), number_cols)
 print("Categorical :", len(category_cols), category_cols)
 print("Date :", date_cols)
 print("ID :", id_cols)

data quality check

print("Missing Values:")
print(df.isnull().sum())
print("\nMissing Ratings")
print(df["Rating"].isnull().sum())
print("\nDuplicate Rows")
print(df.duplicated().sum())
print("\nAre Order IDs Unique")
print(df["Order_ID"].is_unique)

"""Summary Statistics/ Descriptive Statistics

"""

#descriptive statistics
df.describe()

#rounding off
df[number_cols].describe().round(2)

amount = df["Final_Amount"]
 print("mean (average) : RS", round(amount.mean(), 2))
 print("median (middle) : RS", amount.median())
 print("mode (most common) : RS", amount.mode()[0])
 print("Minimum : RS", amount.min())
 print("Maxmimum :RS", amount.max())
 print("standard deviation : RS", round(amount.std(), 2))
 print("Range (max-min): RS", amount.max() - amount.min())

#comparison of mean and median
mean_value = amount.mean()
median_value = amount.median()
print(f"Mean = Rs {mean_value:.2f}")
print(f"Median = Rs {median_value:.2f}")
if mean_value > median_value:
    print("a few large orders may be pulling the average up.")
else:
    print("the average is close to or below the median.")

"""Lecture 6 : data visualization"""

import matplotlib.pyplot as plt
import scipy.stats as stats
order_amount = df["Final_Amount"].dropna()
stats.probplot(order_amount, dist="norm", plot=plt)
plt.title("Q-Q plot of Final Order Amount")
plt.xlabel("Theoretical Quantiles")
plt.ylabel("Sample Quantiles")
plt.show()

city_revenue = df.groupby("City")["Final_Amount"].sum()
city_revenue = city_revenue.sort_values(ascending=False)
print(city_revenue)
city_revenue.plot(kind="bar")
plt.title("Revenue by city")
plt.ylabel("Total Revenue (Rs)")
plt.show()

city_revenue = df.groupby("Cuisine")["Final_Amount"].sum()
city_revenue = city_revenue.sort_values(ascending=False)
print(city_revenue)
city_revenue.plot(kind="bar")
plt.title("Revenue by city")
plt.ylabel("Total Revenue (Rs)")
plt.show()

"""Line Chart

"""

df["Order_Date"] = pd.to_datetime(df["Order_Date"])
monthly_orders = df.groupby(
    df["Order_Date"].dt.to_period("M")
)["Order_ID"].count()
print(monthly_orders)

monthly_orders.plot(kind="line", marker="o")
plt.title("Monthly Demand Trend")
plt.xlabel("Month")
plt.ylabel("Number of Orders")
plt.show()

"""Pie Chart"""

payment_counts = df["Payment_Mode"].value_counts()
plt.pie(payment_counts.values, labels=payment_counts.index, autopct="%1.01f%%")
plt.title("Payment Mode share")
plt.show()

payment_counts = df["Cuisine"].value_counts()
plt.pie(payment_counts.values, labels=payment_counts.index, autopct="%1.01f%%")
plt.title("Cuisine share")
plt.show()

"""histogram"""

plt.hist(df["Final_Amount"].dropna(), bins=10)
plt.title("Distribution of Order Amount")
plt.xlabel(" Final Order Amount (Rs)")
plt.ylabel("Number of Orders")
plt.show()

"""scatter plot

"""

plt.scatter(df["Distance_Km"], df["Delivery_Time_Min"])
plt.title("Delivery Distance vs Delivery Time")
plt.xlabel("Distance (km)")
plt.ylabel("Delivery Time (Minutes)")
plt.show()

"""Heat map

"""

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
city_cuisine = pd.crosstab(df["City"], df["Cuisine"])
sns.heatmap(city_cuisine, annot=True, fmt="d", cmap="Reds")
plt.title("orders: City x Cuisine (seaborn)")
plt.show()

"""Box Plot

"""

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
sns.boxplot(data=df, x="City", y="Delivery_Time_Min")
plt.title("Delivery Time by City (seaborn)")
plt.show()